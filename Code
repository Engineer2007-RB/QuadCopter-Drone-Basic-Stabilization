const int PWM_RES = 1023;  // ESP8266 PWM resolution
const float PERIOD_US = 1000000.0 / PWM_FREQ;  // 2500 µs for 400 Hz

// ----- IMU Data and Timing -----
int16_t ax, ay, az, gx, gy, gz;
float gyroOffsets[3] = {0, 0, 0};
float accelOffsets[3] = {0, 0, 0};
unsigned long prevTime = 0;
float dt = 0.0;

// ----- Filtered Angles and Rates -----
float angles[3] = {0, 0, 0}; // angles[0]: roll, angles[1]: pitch, angles[2]: yaw
float rates[3] = {0, 0, 0};  // rates[0]: roll rate, rates[1]: pitch rate, rates[2]: yaw rate

// ----- PID Parameters for Rate Control -----
float kp_rate = 5.5, ki_rate = 0.01, kd_rate = 0.12;
float int_rate_roll = 0, prev_err_rate_roll = 0;
float int_rate_pitch = 0, prev_err_rate_pitch = 0;
float int_rate_yaw = 0, prev_err_rate_yaw = 0;

// ----- LQR Parameters for Angle Control -----
float K_angle[2] = {2.9, 0.01};  // [angle_gain, rate_gain] for roll/pitch
float default_K_angle[2] = {2.9, 0.01};

// ----- Desired Setpoints -----
float desired_angles[3] = {0, 0, 0};
float desired_rates[3] = {0, 0, 0};

// ----- Base Throttle -----
int base_throttle = 1700;  // Adjusted for 500g payload hover
